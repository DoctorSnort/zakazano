<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <!-- Круглый кроп морды; сам круг уложен в безопасную зону 66dp, поэтому виден целиком
         и под круглой маской, и под квадратной со скруглением. -->
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <!-- Фотографию в один цвет не перекрасишь, поэтому для темизированных значков
         остаётся прежний рисованный кот. -->
    <monochrome android:drawable="@drawable/ic_launcher_mono" />
</adaptive-icon>
